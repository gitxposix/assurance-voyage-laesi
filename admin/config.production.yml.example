# Replace placeholders and configure GitHub OAuth before activation.
backend:
  name: github
  repo: REPLACE_OWNER/REPLACE_REPOSITORY
  branch: REPLACE_PUBLISHING_BRANCH
  base_url: https://REPLACE_AUTH_SERVICE
  auth_endpoint: auth
locale: fr
site_url: https://laesi.ca
media_folder: assets/uploads
public_folder: /assets/uploads
collections:
  - name: informations
    label: Informations du site
    files:
      - name: babillard
        label: Babillard LAESI
        file: assets/babillard.json
        format: json
        fields:
          - label: Français
            name: fr
            widget: object
            fields:
              - {label: Titre, name: title, widget: string}
              - {label: Message, name: message, widget: text}
          - label: Espagnol
            name: es
            widget: object
            fields:
              - {label: Titre, name: title, widget: string}
              - {label: Message, name: message, widget: text}
